# 时区
TZ=Asia/Shanghai

# MySQL
MYSQL_DATABASE=fota_web_platform
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=change-yours-strong-mysql-password

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-yours-strong-minio-password
MINIO_BUCKET_NAME=fota-firmware
MINIO_DEVICE_BUCKET_NAME=device-firmware

# 业务服务
# JWT 密钥建议使用 32+ 字符的随机字符串；上线后不要随意修改，否则已登录用户会全部失效
FOTA_JWT_SECRET=change-yours-to-a-long-random-jwt-secret-at-least-32-chars
FOTA_GATEWAY_PORT=8224

# 宿主机端口映射
# 正式环境通常只对公网开放 80/443 和 8224；其余端口建议仅内网使用或限制来源 IP
NGINX_HTTP_PORT=80
WEB_HTTP_PORT=8080
GATEWAY_HTTP_PORT=8081
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# JVM
JAVA_OPTS_WEB="-Xms256m -Xmx512m"
JAVA_OPTS_GATEWAY="-Xms256m -Xmx512m"
JAVA_OPTS_MOCK="-Xms128m -Xmx256m"
